{
  "name": "@bb/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --external:fastify --external:@fastify/static --external:postgres --external:drizzle-orm",
    "refresh": "tsx src/refresh-cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@bb/shared": "*",
    "@bb/sim": "*",
    "@fastify/static": "^8.1.1",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
